# Database Settings
#---------------------------------
# Network mode (bridge, host, none)
NETWORK_MODE=bridge

# N8N Version (defaults to 'latest' if not set)
N8N_VERSION=latest

# Security Settings
#---------------------------------
# Enforce correct file permissions for settings
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Database Configuration
#---------------------------------
# Choose your database type: sqlite, postgresdb, mysqldb, mongodb
DB_TYPE=sqlite

# PostgreSQL Settings (required if DB_TYPE=postgresdb)
#---------------------------------
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=secure_password

# MySQL Settings (required if DB_TYPE=mysqldb)
#---------------------------------
DB_MYSQLDB_HOST=mysql
DB_MYSQLDB_PORT=3306
DB_MYSQLDB_DATABASE=n8n
DB_MYSQLDB_USER=root
DB_MYSQLDB_PASSWORD=secure_password

# MongoDB Settings (required if DB_TYPE=mongodb)
#---------------------------------
# Format: mongodb://user:password@host:port/database
DB_MONGODB_CONNECTION_URL=mongodb://localhost:27017/n8n

# SQLite Settings (required if DB_TYPE=sqlite)
#---------------------------------
DB_SQLITE_PATH=/home/node/.n8n/database.sqlite

# Task Runners
#---------------------------------
# Enable task runners for secure code execution
N8N_RUNNERS_ENABLED=true

# Runner execution mode (internal or external)
N8N_RUNNERS_MODE=internal

# Maximum task execution time in seconds
N8N_RUNNERS_TIMEOUT=60

# Maximum number of concurrent tasks
N8N_RUNNERS_MAX_CONCURRENCY=5

# Task runners broker port
N8N_RUNNERS_BROKER_PORT=5679

# Broker listen address
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0

# Basic Authentication
#---------------------------------
# Enable basic authentication
N8N_BASIC_AUTH_ACTIVE=false

# Authentication credentials
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=very_secure_password

# General Settings
#---------------------------------
# Base URL for webhooks
WEBHOOK_URL=http://localhost:5678

# Main n8n port
N8N_PORT=5678

# Timezone configuration
GENERIC_TIMEZONE=UTC

# Encryption key (CHANGE THIS in production!)
# Generate using: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your_super_secret_key_here 